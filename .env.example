# ---------------------------------------------------------------------------
# Microsoft Entra ID (Azure AD) app registration used for Microsoft Graph.
# Required application permissions (admin consented):
#   Group.Read.All             groups list / get / members
#   User.Read.All              users get, group members, owners by name/address
#   EntitlementManagement.Read.All        eam list-/get- packages, catalogs, assignments
#   EntitlementManagement.ReadWrite.All   eam add-/remove-assignment only (write)
#   Application.Read.All       apps list/get, sp list / get / assignments / owners
#                              (Directory.Read.All covers these too)
#   Application.ReadWrite.All  sp add-owner / remove-owner only (write)
#
# Verify what the token carries, not what the portal lists:
#   pctl azure token --decode -o json | jq -r '.claims.roles[]'
# ---------------------------------------------------------------------------
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# Prefer a secret injected by your secret manager over a file on disk.
AZURE_CLIENT_SECRET=

# Optional overrides
# PCTL_GRAPH_SCOPE=https://graph.microsoft.com/.default
# PCTL_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# PCTL_AUTHORITY=https://login.microsoftonline.com
# PCTL_NO_TOKEN_CACHE=1

# ---------------------------------------------------------------------------
# OAuth 2.0 (pctl oauth token / login): Auth0, or any provider whose URLs you name.
# Every variable has a flag of the same name, and the flag wins.
# OAUTH_ISSUER gives <issuer>/oauth/token and <issuer>/authorize. Name OAUTH_TOKEN_URL
# (and OAUTH_AUTHORIZE_URL for login) instead for a provider with another layout.
# ---------------------------------------------------------------------------
OAUTH_ISSUER=
OAUTH_CLIENT_ID=
# Prefer a secret injected by your secret manager over a file on disk, and over the
# --client-secret flag, which lands in shell history and the process list.
OAUTH_CLIENT_SECRET=
OAUTH_AUDIENCE=

# Optional
# OAUTH_TOKEN_URL=
# OAUTH_SCOPE=
# login only:
# OAUTH_AUTHORIZE_URL=
# OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
# OAUTH_LOGIN_TIMEOUT=300
# PCTL_OAUTH_SECRET_ID=

# ---------------------------------------------------------------------------
# AWS - standard SDK variables apply (profile / SSO / role chaining all work).
# ---------------------------------------------------------------------------
# AWS_PROFILE=my-profile
# AWS_REGION=eu-west-1
